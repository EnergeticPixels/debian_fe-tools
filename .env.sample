# Base Editor
# Install Neovim and set it as default editor during begin_here.sh
NEOVIM_ENABLE=true
# Neovim version installed from upstream release tarball (0.12.0 or newer)
NEOVIM_VERSION=0.12.0

# Front-end Creative Apps
INKSCAPE_ENABLE=false
GIMP_ENABLE=false
BLENDER_ENABLE=false
AUDACITY_ENABLE=false
# Choose one video editor: none, openshot
VIDEO_EDITOR=none
